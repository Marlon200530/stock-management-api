{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "express"]
  },
  "include": ["src", "env.ts", "drizzle.config.ts", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
